# Environment variables

# MT5 bridge URL
MT5_BRIDGE_URL=http://localhost:5000
# Shared secret used by the MT5 bridge (X-MT5-BRIDGE-KEY)
MT5_BRIDGE_KEY=CHANGE_ME

# If using Vite in the frontend, use the VITE_ prefix for variables exposed to the client
# VITE_MT5_BRIDGE_URL=http://localhost:5000
# VITE_MT5_BRIDGE_KEY=CHANGE_ME
